```gitignore
# ============================================================
# CMake / Build
# ============================================================

# All build directories, at any level
**/build/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
Makefile
build.ninja
.ninja_deps
.ninja_log

# CMake API / File API
.cmake/

# ============================================================
# Compiled binaries / objects
# ============================================================

*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.o
*.obj

# Debug symbols
*.pdb
*.ilk

# ============================================================
# IDE
# ============================================================

# Keep VS Code project configuration, but ignore its user-specific
# state if it appears later.

.vscode/*.log
.vscode/.ropeproject/

# ============================================================
# CMake User Presets
# ============================================================

# Local/user-specific presets can contain machine-specific paths
CMakeUserPresets.json

# ============================================================
# OS
# ============================================================

.DS_Store
Thumbs.db
Desktop.ini
```
